<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>4339dce8-946e-4509-a2a9-26323df0e317</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.18" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LicenseManager.Core\LicenseManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

	<Import Project="..\LicenseKeys.local.props" Condition="Exists('..\LicenseKeys.local.props')" />

	<ItemGroup>
		<AssemblyMetadata Include="LicensePublicKey_1" Value="$(LicensePublicKey1)" Condition="'$(LicensePublicKey1)' != ''" />

		<AssemblyMetadata Include="LicensePublicKey_2" Value="$(LicensePublicKey2)" Condition="'$(LicensePublicKey2)' != ''" />
	</ItemGroup>

	<Target Name="ValidateLicensePublicKeys" BeforeTargets="BeforeCompile">

		<Error Condition="'$(LicensePublicKey1)' == ''" Text="License Manager build hatası: LicensePublicKey1 bulunamadı. LicenseKeys.local.props dosyasını ve public key yapılandırmasını kontrol edin." />

	</Target>
	
</Project>
